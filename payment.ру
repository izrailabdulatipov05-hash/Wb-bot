import hashlib
import logging
from aiohttp import web

logger = logging.getLogger(__name__)

ROBOKASSA_LOGIN = "Wildberrieshelp"
ROBOKASSA_PASS1 = "CbuIo7JXy353myxVO5kK"
ROBOKASSA_PASS2 = "uXBbo8iGOHzoD32Y8l7G"


def generate_payment_url(amount: int, order_id: int, description: str) -> str:
    """Генерирует ссылку на оплату Робокассы"""
    signature = hashlib.md5(
        f"{ROBOKASSA_LOGIN}:{amount}:{order_id}:{ROBOKASSA_PASS1}".encode()
    ).hexdigest()
    
    desc_encoded = description.replace(" ", "+")
    url = (
        f"https://auth.robokassa.ru/Merchant/Index.aspx"
        f"?MerchantLogin={ROBOKASSA_LOGIN}"
        f"&OutSum={amount}"
        f"&InvId={order_id}"
        f"&Description={desc_encoded}"
        f"&SignatureValue={signature}"
        f"&IsTest=0"
    )
    return url


def verify_payment(out_sum: str, inv_id: str, signature: str) -> bool:
    """Проверяет подпись от Робокассы"""
    expected = hashlib.md5(
        f"{out_sum}:{inv_id}:{ROBOKASSA_PASS2}".encode()
    ).hexdigest()
    return expected.lower() == signature.lower()


async def robokassa_webhook(request: web.Request, bot, db):
    """Обработчик уведомлений от Робокассы"""
    try:
        data = await request.post()
        out_sum = data.get("OutSum", "")
        inv_id = data.get("InvId", "")
        signature = data.get("SignatureValue", "")
        
        logger.info(f"Robokassa webhook: InvId={inv_id} OutSum={out_sum}")
        
        if not verify_payment(out_sum, inv_id, signature):
            logger.error(f"Invalid signature for InvId={inv_id}")
            return web.Response(text="bad sign")
        
        # InvId формат: TELEGRAM_ID_PLAN (например: 8778493098_m1)
        parts = inv_id.split("_", 1)
        if len(parts) != 2:
            logger.error(f"Invalid InvId format: {inv_id}")
            return web.Response(text="bad invid")
        
        telegram_id = int(parts[0])
        plan_key = parts[1]
        
        # Тарифы
        PLANS = {
            "m1":  (1000,   30),
            "m2":  (2000,   60),
            "m3":  (3000,   90),
            "m4":  (4000,  120),
            "m5":  (5000,  150),
            "m6":  (6000,  180),
            "m12": (12000, 365),
        }
        
        if plan_key not in PLANS:
            logger.error(f"Unknown plan: {plan_key}")
            return web.Response(text="bad plan")
        
        tokens, days = PLANS[plan_key]
        
        # Активируем подписку
        await db.activate_plan(telegram_id, plan_key, tokens, days)
        logger.info(f"✅ Plan {plan_key} activated for user {telegram_id}")
        
        # Уведомляем пользователя
        try:
            months = days // 30
            await bot.send_message(
                telegram_id,
                f"✅ *Оплата прошла успешно!*\n\n"
                f"📋 Подписка: *{months} мес.*\n"
                f"🎟 Токенов: *{tokens:,}*\n\n"
                f"Бот уже работает и отвечает на ваши отзывы 🚀",
                parse_mode="Markdown"
            )
        except Exception as e:
            logger.error(f"Failed to notify user {telegram_id}: {e}")
        
        return web.Response(text=f"OK{inv_id}")
        
    except Exception as e:
        logger.error(f"Webhook error: {e}")
        return web.Response(text="error", status=500)
